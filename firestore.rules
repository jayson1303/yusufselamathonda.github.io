rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Koleksi Produk Motor: Publik hanya bisa baca, Admin login bisa tambah/edit/hapus
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Koleksi Promo & Brosur: Publik hanya bisa baca, Admin login bisa tambah/edit/hapus
    match /promos/{promoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Koleksi Testimoni: Publik hanya bisa baca, Admin login bisa tambah/edit/hapus
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Koleksi Pengaturan Umum Website: Publik hanya bisa baca, Admin login bisa ubah
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default fallback: Tolak semua akses lainnya
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
